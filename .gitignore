# Lab Results and Captures
# Packet captures are untracked everywhere, including copies the notebook
# stores under notebooks/run-store/<run_id>/captures/ for Wireshark.
# Those paths are recorded in the run's metadata.json.
lab_results/
env1_results/
env2_results/
*.pcap
*.pcapng

# Data Files
*.csv
*.txt
results/

# Dependency lists, not results dumps. *.txt above would hide both.
!requirements-analysis.txt
!docker/requirements-harness.txt

# The notebook's labeled example fixture and versionable run store are CSV
# on purpose. Re-include them. Captures stay ignored by *.pcapng above.
!notebooks/sample_lab_results/**/*.csv
!notebooks/run-store/**/*.csv

# Plot images saved next to a local run
notebooks/run-store/**/figures/

# Python / Jupyter
__pycache__/
*.py[cod]
.ipynb_checkpoints/

# OS Files
.DS_Store
.DS_Store?
*.swp
*.swo
*~

# IDE
.vscode/
.idea/
*.log
